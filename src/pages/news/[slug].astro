---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

// هذه الدالة تخبر Astro بإنشاء صفحة منفصلة لكل خبر في المجلد
export async function getStaticPaths() {
  const newsEntries = await getCollection('news', ({ data }) => !data.draft);
  return newsEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// جلب اسم التصنيف
const categories = await getCollection('categories');
const categoryName = categories.find(c => c.slug === entry.data.category)?.data.name;

// تنسيق التاريخ
const formattedDate = new Intl.DateTimeFormat('ar-EG', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(entry.data.date);
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <Header />

  <main class="container article-container">
    
    <article class="single-article">
      
      <!-- عنوان الخبر -->
      <header class="article-header">
        {categoryName && <span class="article-category">{categoryName}</span>}
        <h1 class="article-title">{entry.data.title}</h1>
        <time class="article-date" datetime={entry.data.date.toISOString()}>{formattedDate}</time>
      </header>

      <!-- صورة الخبر (إن وجدت) -->
      {entry.data.image && (
        <div class="article-image-wrapper">
          <img src={entry.data.image} alt={entry.data.title} class="article-image" />
        </div>
      )}

      <!-- نص الخبر الكامل -->
      <div class="article-body">
        <Content />
      </div>

    </article>

  </main>

  <Footer />
</BaseLayout>

<style>
  .article-container {
    padding-top: 40px;
    padding-bottom: 60px;
    max-width: 800px; /* عرض محدود لراحة العين أثناء القراءة */
  }

  .single-article {
    background: var(--card-bg);
    padding: 30px;
    border-radius: 12px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }

  .article-header {
    margin-bottom: 24px;
    text-align: center;
  }

  .article-category {
    color: var(--accent);
    font-weight: 800;
    font-size: 14px;
    display: inline-block;
    margin-bottom: 10px;
    background: rgba(192, 57, 43, 0.1);
    padding: 4px 12px;
    border-radius: 4px;
  }

  .article-title {
    font-size: 28px;
    line-height: 1.4;
    font-weight: 900;
    margin-bottom: 12px;
    color: var(--text);
  }

  .article-date {
    color: var(--muted);
    font-size: 14px;
  }

  .article-image-wrapper {
    margin-bottom: 30px;
    border-radius: 10px;
    overflow: hidden;
  }

  .article-image {
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: cover;
  }

  /* تنسيق النص الداخلي للخبر */
  .article-body {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text);
  }

  .article-body p {
    margin-bottom: 20px;
  }

  .article-body h2, .article-body h3 {
    margin-top: 30px;
    margin-bottom: 15px;
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .single-article {
      padding: 20px;
      border-radius: 0;
      border-left: none;
      border-right: none;
    }
    .article-title {
      font-size: 22px;
    }
  }
</style>
