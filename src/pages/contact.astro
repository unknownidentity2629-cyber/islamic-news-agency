---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const telegramLink = "https://t.me/unknown262977";
---

<BaseLayout title="تواصل معنا">
  <Header />

  <main class="container main-content">
    <div class="page-card">
      <h1 class="page-title">تواصل معنا</h1>
      
      <div class="page-body">
        <p>نرحب بتواصلكم معنا دائماً. سواء كان لديكم اقتراح، ملاحظة، أو ترغبون في إرسال خبر أو استفسار، يمكنكم التواصل مع فريق <strong>وكالة الأنباء الإسلامية</strong> مباشرة عبر تطبيق تليجرام.</p>
        
        <p>اضغط على الزر أدناه للتواصل معنا:</p>

        <div class="contact-action">
          <a href={telegramLink} target="_blank" rel="noopener" class="telegram-btn-large">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
            <span>تواصل عبر تليجرام</span>
          </a>
        </div>

        <p class="note">ملاحظة: نحن نرد على الرسائل في أقرب وقت ممكن. يرجى عدم إرسال رسائل مزعجة.</p>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .main-content {
    padding-top: 40px;
    padding-bottom: 60px;
    flex-grow: 1;
    max-width: 800px;
  }

  .page-card {
    background: var(--card-bg);
    padding: 30px;
    border-radius: 12px;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    text-align: center;
  }

  .page-title {
    font-size: 28px;
    font-weight: 900;
    color: var(--accent);
    margin-bottom: 24px;
    padding-bottom: 15px;
    border-bottom: 1px solid var(--border);
  }

  .page-body {
    font-size: 16px;
    line-height: 1.8;
    color: var(--text);
  }

  .page-body p {
    margin-bottom: 16px;
  }

  .page-body strong {
    color: var(--accent);
  }

  .contact-action {
    margin: 40px 0;
    display: flex;
    justify-content: center;
  }

  /* تنسيق الزر الكبير لتليجرام */
  .telegram-btn-large {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background-color: #229ED9; /* لون تليجرام الرسمي */
    color: white !important;
    padding: 16px 32px;
    border-radius: 50px;
    font-size: 18px;
    font-weight: bold;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(34, 158, 217, 0.3);
  }

  .telegram-btn-large:hover {
    background-color: #1e8bc3;
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(34, 158, 217, 0.5);
  }

  .note {
    font-size: 14px;
    color: var(--muted);
    margin-top: 30px;
  }

  @media (max-width: 600px) {
    .page-card {
      padding: 20px;
      border-radius: 0;
      border-left: none;
      border-right: none;
    }
    .page-title {
      font-size: 24px;
    }
    .telegram-btn-large {
      padding: 12px 24px;
      font-size: 16px;
    }
  }
</style>
