---
const year = new Date().getFullYear();
const telegramLink = "https://t.me/unknown262977";
---

<footer class="site-footer">
  <div class="container footer-inner">
    
    <div class="footer-brand">
      <strong>وكالة الأنباء الإسلامية</strong>
      <p>مصداقية الخبر... وسرعة الوصول</p>
    </div>

    <div class="footer-links">
      <a href="/privacy">سياسة الخصوصية</a>
      <a href="/contact">تواصل معنا</a>
      
      <!-- زر تليجرام مع الأيقونة -->
      <a href={telegramLink} target="_blank" rel="noopener" class="telegram-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
        </svg>
        <span>تليجرام</span>
      </a>

    </div>

  </div>
  
  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {year} وكالة الأنباء الإسلامية. جميع الحقوق محفوظة.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--card-bg);
    border-top: 1px solid var(--border);
    margin-top: auto;
    padding-top: 40px;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    padding-bottom: 30px;
  }

  .footer-brand strong {
    font-size: 18px;
    color: var(--accent);
    display: block;
    margin-bottom: 4px;
  }

  .footer-brand p {
    color: var(--muted);
    font-size: 14px;
  }

  .footer-links {
    display: flex;
    gap: 20px;
    font-size: 14px;
    font-weight: 600;
    align-items: center;
  }

  .footer-links a {
    color: var(--text);
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  /* تنسيق خاص لزر التليجرام ليظهر الأيقونة والنص بجانب بعضهما */
  .telegram-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: #229ED9; /* لون تليجرام الرسمي */
    color: white !important;
    padding: 6px 14px;
    border-radius: 20px;
    transition: opacity 0.2s, transform 0.2s;
  }

  .telegram-btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
    color: white !important;
  }

  .footer-bottom {
    background: var(--bg-alt);
    padding: 15px 0;
    text-align: center;
    border-top: 1px solid var(--border);
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
    .footer-links {
      justify-content: center;
      flex-wrap: wrap;
    }
  }
</style>
