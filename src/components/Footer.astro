---
const year = new Date().getFullYear();
const telegramLink = "https://t.me/unknown262977";
---

<footer class="site-footer">
  <div class="container footer-inner">
    
    <div class="footer-brand">
      <strong>وكالة الأنباء الإسلامية</strong>
      <p>مصداقية الخبر... وسرعة الوصول</p>
    </div>

    <div class="footer-links">
      <a href="/privacy">سياسة الخصوصية</a>
      <a href="/contact">تواصل معنا</a>
      <a href={telegramLink} target="_blank" rel="noopener">تليجرام</a>
    </div>

  </div>
  
  <div class="footer-bottom">
    <div class="container">
      <p>&copy; {year} وكالة الأنباء الإسلامية. جميع الحقوق محفوظة.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--card-bg);
    border-top: 1px solid var(--border);
    margin-top: auto;
    padding-top: 40px;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    padding-bottom: 30px;
  }

  .footer-brand strong {
    font-size: 18px;
    color: var(--accent);
    display: block;
    margin-bottom: 4px;
  }

  .footer-brand p {
    color: var(--muted);
    font-size: 14px;
  }

  .footer-links {
    display: flex;
    gap: 20px;
    font-size: 14px;
    font-weight: 600;
  }

  .footer-links a {
    color: var(--text);
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    background: var(--bg-alt);
    padding: 15px 0;
    text-align: center;
    border-top: 1px solid var(--border);
    font-size: 13px;
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
    .footer-links {
      justify-content: center;
    }
  }
</style>
